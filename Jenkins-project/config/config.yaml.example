# Example configuration for Jenkins AI Agent
agent:
  poll_interval_seconds: 60
  max_log_chars: 8000
  lookback_builds: 3
  job_filter: []
  ignore_jobs: []

jenkins:
  ssm_url_param: "/jenkins-ai-agent/jenkins/url"
  ssm_username_param: "/jenkins-ai-agent/jenkins/username"
  ssm_token_param: "/jenkins-ai-agent/jenkins/api_token"
  verify_ssl: false
  connect_timeout: 10
  read_timeout: 30

bedrock:
  region: "us-east-1"
  model_id: "amazon.nova-pro-v1:0"
  temperature: 0.2
  max_tokens: 1024

gchat:
  ssm_webhook_param: "/jenkins-ai-agent/gchat/webhook_url"
  callback_base_url: "http://YOUR_EC2_PUBLIC_IP:5000"

email:
  enabled: false
  sender: ""
  recipient: ""
  smtp_server: "smtp.gmail.com"
  smtp_port: 587
  username_ssm_param: "/jenkins-ai-agent/email/username"
  password_ssm_param: "/jenkins-ai-agent/email/password"

remediation:
  allowed_actions:
    - "retry_build"
    - "rebuild_with_params"
  auto_execute: true

logging:
  level: "INFO"
  file: "logs/agent.log"
  max_bytes: 10485760
  backup_count: 5
